---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Luca Flammia, PhD — Data Scientist @ Extendi | AI Architecture & Agentic Systems"
  description="Data Scientist at Extendi, specializing in AI Architecture and agentic systems. Educator and speaker on applied AI, Model Context Protocol, and production ML engineering."
  lang="en"
>
  <!-- NAV -->
  <nav class="fixed top-0 left-0 right-0 z-50 border-b border-[#222222] bg-[#0a0a0a]/90 backdrop-blur-sm">
    <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href="/" class="text-sm font-medium tracking-widest uppercase text-[#c9a84c] hover:text-[#a07c30] transition-colors">LF</a>
      <div class="flex items-center gap-8 text-sm text-[#8a8480]">
        <a href="#background" class="hover:text-[#f5f0eb] transition-colors">Background</a>
        <a href="/" class="hover:text-[#f5f0eb] transition-colors text-xs tracking-widest uppercase">IT</a>
        <a
          href="mailto:luca.flammia@gmail.com"
          class="px-4 py-2 border border-[#c9a84c] text-[#c9a84c] text-xs tracking-widest uppercase hover:bg-[#c9a84c] hover:text-[#0a0a0a] transition-all duration-200"
        >
          Contact
        </a>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <section class="min-h-screen flex flex-col justify-center pt-20 px-6">
    <div class="max-w-5xl mx-auto w-full">
      <div class="mb-6">
        <span class="text-xs tracking-[0.3em] uppercase text-[#c9a84c] font-medium">
          Data Scientist @ Extendi · AI Architecture & Agentic Systems
        </span>
      </div>

      <h1 class="text-5xl md:text-7xl font-light leading-[1.05] tracking-tight mb-8 text-[#f5f0eb]">
        Luca Flammia<span class="text-[#c9a84c]">,</span><br />
        <span class="font-extralight text-[#8a8480]">PhD</span>
      </h1>

      <p class="text-xl md:text-2xl font-light text-[#8a8480] mb-4 max-w-2xl leading-relaxed">
        Data Scientist @ Extendi | Specializing in AI Architecture & Agentic Systems
      </p>

      <p class="text-base md:text-lg text-[#8a8480] mb-12 max-w-xl leading-relaxed font-light">
        Data Scientist focused on <span class="text-[#f5f0eb]">AI architecture</span> and
        <span class="text-[#f5f0eb]"> production ML engineering</span>.
        Day-to-day work: data lifecycle management, model training, validation, and enterprise deployment.
        AI Architecture is the engineering methodology around those models. Speaker and educator on agentic systems.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 items-start">
        <a
          href="#background"
          class="inline-flex items-center gap-3 px-8 py-4 bg-[#c9a84c] text-[#0a0a0a] text-sm font-medium tracking-widest uppercase hover:bg-[#a07c30] transition-colors duration-200"
        >
          Explore Background
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a
          href="/"
          class="inline-flex items-center gap-3 px-8 py-4 border border-[#222222] text-[#8a8480] text-sm tracking-widest uppercase hover:border-[#444444] hover:text-[#f5f0eb] transition-all duration-200"
        >
          Versione italiana →
        </a>
      </div>
    </div>
  </section>

  <!-- BACKGROUND -->
  <section id="background" class="py-32 px-6 border-t border-[#111111]">
    <div class="max-w-5xl mx-auto">
      <div class="mb-16">
        <span class="text-xs tracking-[0.3em] uppercase text-[#c9a84c] font-medium">Background</span>
        <h2 class="text-3xl md:text-4xl font-light mt-3 text-[#f5f0eb]">
          From quantum research<br />to enterprise ML engineering
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-16">
        <div>
          <p class="text-[#8a8480] leading-relaxed mb-6">
            I hold a <span class="text-[#f5f0eb]">joint international PhD in Theoretical and Computational Physics</span> from the University of Antwerp (Belgium) and the University of Camerino (Italy), awarded in 2018. My doctoral research focused on emergent phenomena in quantum-confined nanostructured superconductors — involving large-scale HPC simulations, peer-reviewed publications, and international conference presentations.
          </p>
          <p class="text-[#8a8480] leading-relaxed">
            Today I work as a Senior Data Scientist at <span class="text-[#f5f0eb]">Extendi</span>, managing full ML model lifecycles in enterprise environments: data curation, training, validation, and production deployment on AWS and Azure. AI Architecture is the engineering methodology I apply around those models — event-driven flows, agentic orchestration, and the Model Context Protocol.
          </p>
        </div>

        <div class="space-y-6">
          <div class="p-5 border border-[#1a1a1a]">
            <h3 class="text-sm font-medium text-[#c9a84c] mb-2">Academic</h3>
            <p class="text-xs text-[#8a8480]">PhD Computational Physics · Joint Antwerp + Camerino · 2014–2018</p>
            <p class="text-xs text-[#8a8480]">MSc Theoretical Physics · University of Modena · 2010–2013</p>
          </div>
          <div class="p-5 border border-[#c9a84c]/20">
            <div class="flex items-center gap-2 mb-2">
              <h3 class="text-sm font-medium text-[#c9a84c]">Current Role</h3>
              <span class="text-xs px-1.5 py-0.5 bg-[#c9a84c]/10 border border-[#c9a84c]/30 text-[#c9a84c]">Active</span>
            </div>
            <p class="text-xs text-[#f5f0eb] font-medium">Senior Data Scientist · Extendi · 2022–present</p>
            <p class="text-xs text-[#8a8480] mt-1">NLP & LLM Systems · Enterprise ML Deployment</p>
            <p class="text-xs text-[#8a8480] mt-2 pt-2 border-t border-[#1a1a1a]">Data Scientist · Multitraccia · 2021–2022</p>
            <p class="text-xs text-[#8a8480]">Software Developer · Energee3 · 2018–2021</p>
          </div>
          <div class="p-5 border border-[#1a1a1a]">
            <h3 class="text-sm font-medium text-[#8a8480] mb-2">Off-Hours Educational Activities</h3>
            <p class="text-xs text-[#8a8480]">AI Instructor · Agentic Systems & MCP · Fargin Academy · 2025–present</p>
            <p class="text-xs text-[#8a8480]">Technical Speaker · ML Modena Meetup · 2025–present</p>
          </div>
        </div>
      </div>

      <!-- Key results -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-[#111111]">
        <div class="bg-[#0a0a0a] p-8">
          <p class="text-3xl font-light text-[#c9a84c] mb-2">−15%</p>
          <p class="text-xs text-[#8a8480]">Route optimization for healthcare logistics with Google OR-Tools</p>
        </div>
        <div class="bg-[#0a0a0a] p-8">
          <p class="text-3xl font-light text-[#c9a84c] mb-2">+300%</p>
          <p class="text-xs text-[#8a8480]">Synthetic training dataset expansion (Llama 3 + Mixtral 8x7B) preserving label distribution</p>
        </div>
        <div class="bg-[#0a0a0a] p-8">
          <p class="text-3xl font-light text-[#c9a84c] mb-2">99%</p>
          <p class="text-xs text-[#8a8480]">Patient coverage within 3 days with priority-queue scheduling (vs. 87% baseline)</p>
        </div>
      </div>

      <!-- Expertise areas -->
      <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-5 border border-[#1a1a1a]">
          <h4 class="text-sm font-medium text-[#c9a84c] mb-3">AI & LLM Systems</h4>
          <ul class="space-y-1 text-xs text-[#8a8480]">
            <li>Agentic workflow design (MCP)</li>
            <li>LLM fine-tuning (Llama 3, Mixtral, GPT)</li>
            <li>Synthetic data generation</li>
            <li>RAG and vector search</li>
            <li>Production-grade NLP pipelines</li>
          </ul>
        </div>
        <div class="p-5 border border-[#1a1a1a]">
          <h4 class="text-sm font-medium text-[#c9a84c] mb-3">Engineering & Cloud</h4>
          <ul class="space-y-1 text-xs text-[#8a8480]">
            <li>Python, Ruby, FastAPI, Rails</li>
            <li>AWS, Azure (ML services)</li>
            <li>MySQL, PostgreSQL</li>
            <li>Optimization algorithms (OR-Tools)</li>
            <li>CI/CD, Agile/Scrum</li>
          </ul>
        </div>
        <div class="p-5 border border-[#1a1a1a]">
          <h4 class="text-sm font-medium text-[#c9a84c] mb-3">Domain Verticals</h4>
          <ul class="space-y-1 text-xs text-[#8a8480]">
						<li><strong>Enterprise AI</strong> — Compliance & Security (AI Act / DORA)</li>
						<li><strong>Media Tech</strong> — Audience Intelligence & Engagement</li>
						<li><strong>Industry 4.0</strong> — Predictive Maintenance & Analytics</li>
						<li><strong>Logistics</strong> — Supply Chain & Operational Optimization</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="py-32 px-6 border-t border-[#111111]">
    <div class="max-w-5xl mx-auto">
      <div class="max-w-2xl">
        <span class="text-xs tracking-[0.3em] uppercase text-[#c9a84c] font-medium">Contact</span>
        <h2 class="text-3xl md:text-4xl font-light mt-3 mb-6 text-[#f5f0eb]">
          Let's Talk AI
        </h2>
        <p class="text-[#8a8480] leading-relaxed mb-4">
          Open to technical conversations on agentic systems, enterprise ML architecture, and production model engineering.
          Available as a speaker for meetups and conferences on applied AI.
        </p>
        <p class="text-sm text-[#8a8480] mb-10">
          <span class="text-[#f5f0eb]">Data Scientist @ Extendi.</span> Educator and speaker on AI Architecture in my spare time.
        </p>

        <!-- Contact form -->
        <form
          id="contact-form-en"
          action="https://formspree.io/f/mdajbdan"
          method="POST"
          class="space-y-4 mb-10"
        >
          <div>
            <label for="name-en" class="block text-xs tracking-widest uppercase text-[#8a8480] mb-2">Name</label>
            <input
              id="name-en"
              type="text"
              name="name"
              required
              placeholder="Your name"
              class="w-full bg-[#0d0d0d] border border-[#222222] text-[#f5f0eb] text-sm px-4 py-3 placeholder-[#444444] focus:outline-none focus:border-[#c9a84c] transition-colors"
            />
          </div>
          <div>
            <label for="email-en" class="block text-xs tracking-widest uppercase text-[#8a8480] mb-2">Email Address</label>
            <input
              id="email-en"
              type="email"
              name="email"
              required
              placeholder="your@email.com"
              class="w-full bg-[#0d0d0d] border border-[#222222] text-[#f5f0eb] text-sm px-4 py-3 placeholder-[#444444] focus:outline-none focus:border-[#c9a84c] transition-colors"
            />
          </div>
          <div>
            <label for="message-en" class="block text-xs tracking-widest uppercase text-[#8a8480] mb-2">Message</label>
            <textarea
              id="message-en"
              name="message"
              required
              rows="5"
              placeholder="What would you like to discuss?"
              class="w-full bg-[#0d0d0d] border border-[#222222] text-[#f5f0eb] text-sm px-4 py-3 placeholder-[#444444] focus:outline-none focus:border-[#c9a84c] transition-colors resize-none"
            ></textarea>
          </div>
          <div id="success-en" class="hidden p-4 border border-[#c9a84c]/30 bg-[#c9a84c]/5 text-sm text-[#c9a84c]">
            Message sent. I'll reply within 24–48 hours.
          </div>
          <button
            type="submit"
            class="inline-flex items-center gap-3 px-8 py-4 bg-[#c9a84c] text-[#0a0a0a] text-sm font-medium tracking-widest uppercase hover:bg-[#a07c30] transition-colors duration-200 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Send Message
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </form>

        <div class="mt-12 pt-12 border-t border-[#111111] grid grid-cols-1 sm:grid-cols-3 gap-8 text-sm">
          <div>
            <p class="text-[#c9a84c] font-medium mb-1">Location</p>
            <p class="text-[#8a8480]">Modena, Italy<br />Available remotely</p>
          </div>
          <div>
            <p class="text-[#c9a84c] font-medium mb-1">Technical Focus</p>
            <p class="text-[#8a8480]">Enterprise AI,<br />LLM Systems, MCP</p>
          </div>
          <div>
            <p class="text-[#c9a84c] font-medium mb-1">Contact</p>
            <p class="text-[#8a8480]">
              <a href="mailto:luca.flammia@gmail.com" class="hover:text-[#f5f0eb] transition-colors">luca.flammia@gmail.com</a><br />
              <a href="https://linkedin.com/in/lucaflammia" target="_blank" rel="noopener" class="hover:text-[#f5f0eb] transition-colors">LinkedIn</a>
              &nbsp;·&nbsp;
              <a href="https://github.com/lucaflammia" target="_blank" rel="noopener" class="hover:text-[#f5f0eb] transition-colors">GitHub</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const formEn = document.getElementById('contact-form-en') as HTMLFormElement | null;
    const successEn = document.getElementById('success-en');
    formEn?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = formEn.querySelector('button[type="submit"]') as HTMLButtonElement;
      btn.disabled = true;
      const data = new FormData(formEn);
      const res = await fetch(formEn.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      if (res.ok) {
        formEn.reset();
        successEn?.classList.remove('hidden');
      } else {
        btn.disabled = false;
        alert('Submission failed. Please try again or email luca.flammia@gmail.com directly.');
      }
    });
  </script>

  <!-- FOOTER -->
  <footer class="py-8 px-6 border-t border-[#111111]">
    <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#444444]">
      <span>© 2026 Luca Flammia.</span>
      <div class="flex items-center gap-6">
        <a href="/" class="hover:text-[#8a8480] transition-colors">Italiano</a>
        <a href="/blog" class="hover:text-[#8a8480] transition-colors">Articles (IT)</a>
        <a href="mailto:luca.flammia@gmail.com" class="hover:text-[#8a8480] transition-colors">Contact</a>
      </div>
    </div>
  </footer>
</Layout>
