---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Luca Flammia, PhD — AI Solutions Architect & Engineer"
  description="Consulente Senior Indipendente specializzato nella progettazione di sistemi agentici e automazione intelligente per il settore FSI e Enterprise. Regime B2B."
  lang="it"
>
  <!-- NAV -->
  <nav class="fixed top-0 left-0 right-0 z-50 border-b border-[#222222] bg-[#0a0a0a]/90 backdrop-blur-sm">
    <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
      <span class="text-sm font-medium tracking-widest uppercase text-[#c9a84c]">LF</span>
      <div class="flex items-center gap-8 text-sm text-[#8a8480]">
        <a href="#percorso" class="hover:text-[#f5f0eb] transition-colors">Percorso</a>
        <a href="/blog" class="hover:text-[#f5f0eb] transition-colors">Articoli</a>
        <a href="/en" class="hover:text-[#f5f0eb] transition-colors text-xs tracking-widest uppercase">EN</a>
        <a
          href="#booking"
          class="px-4 py-2 border border-[#c9a84c] text-[#c9a84c] text-xs tracking-widest uppercase hover:bg-[#c9a84c] hover:text-[#0a0a0a] transition-all duration-200"
        >
          Discovery Call
        </a>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <section class="min-h-screen flex flex-col justify-center pt-20 px-6">
    <div class="max-w-5xl mx-auto w-full">
      <div class="mb-6">
        <span class="text-xs tracking-[0.3em] uppercase text-[#c9a84c] font-medium">
          Consulente Senior Indipendente · Regime B2B
        </span>
      </div>

      <h1 class="text-5xl md:text-7xl font-light leading-[1.05] tracking-tight mb-8 text-[#f5f0eb]">
        Luca Flammia<span class="text-[#c9a84c]">,</span><br />
        <span class="font-extralight text-[#8a8480]">PhD</span>
      </h1>

      <p class="text-xl md:text-2xl font-light text-[#8a8480] mb-4 max-w-2xl leading-relaxed">
        AI Solutions Architect & Engineer
      </p>

      <p class="text-base md:text-lg text-[#8a8480] mb-12 max-w-xl leading-relaxed font-light">
        Progetto e implemento sistemi agentici e soluzioni di automazione intelligente
        per il settore <span class="text-[#f5f0eb]">FSI</span> e <span class="text-[#f5f0eb]">Enterprise</span>.
        Dal dottorato in fisica computazionale all'architettura di sistemi AI in produzione.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 items-start">
        <a
          href="#booking"
          class="inline-flex items-center gap-3 px-8 py-4 bg-[#c9a84c] text-[#0a0a0a] text-sm font-medium tracking-widest uppercase hover:bg-[#a07c30] transition-colors duration-200"
        >
          Prenota una Discovery Call
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a
          href="/blog"
          class="inline-flex items-center gap-3 px-8 py-4 border border-[#222222] text-[#8a8480] text-sm tracking-widest uppercase hover:border-[#444444] hover:text-[#f5f0eb] transition-all duration-200"
        >
          Leggi gli articoli
        </a>
      </div>

      <!-- Scroll indicator -->
      <div class="mt-24 flex items-center gap-3 text-[#444444]">
        <div class="w-px h-12 bg-[#222222]"></div>
        <span class="text-xs tracking-widest uppercase">Scorri</span>
      </div>
    </div>
  </section>

  <!-- CAREER ARC -->
  <section id="percorso" class="py-32 px-6 border-t border-[#111111]">
    <div class="max-w-5xl mx-auto">
      <div class="mb-16">
        <span class="text-xs tracking-[0.3em] uppercase text-[#c9a84c] font-medium">Percorso</span>
        <h2 class="text-3xl md:text-4xl font-light mt-3 text-[#f5f0eb]">
          Dalla ricerca quantistica<br />all'architettura AI
        </h2>
      </div>

      <div class="space-y-0">
        <!-- PhD -->
        <div class="relative pl-8 pb-12 border-l border-[#222222] group">
          <div class="absolute left-[-5px] top-1 w-2.5 h-2.5 rounded-full bg-[#c9a84c]"></div>
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2 mb-3">
            <div>
              <h3 class="text-lg font-medium text-[#f5f0eb]">Dottorato di Ricerca — Fisica Teorica e Computazionale</h3>
              <p class="text-sm text-[#c9a84c]">Università di Anversa (Belgio) & Università di Camerino (Italia)</p>
            </div>
            <span class="text-sm text-[#8a8480] whitespace-nowrap">Dic 2014 – Dic 2018</span>
          </div>
          <p class="text-sm text-[#8a8480] leading-relaxed max-w-2xl">
            Dottorato congiunto internazionale. Tesi: <em class="text-[#f5f0eb]">Fenomeni emergenti in film superconduttori nanostrutturati a confinamento quantistico</em>.
            Simulazioni HPC ad alte prestazioni, pubblicazioni peer-reviewed, conferenze internazionali.
            Il rigore metodologico acquisito nella ricerca quantistica è la fondazione che distingue un architetto AI da un praticante autodidatta.
          </p>
          <div class="mt-3 flex flex-wrap gap-2">
            <span class="text-xs px-2 py-1 border border-[#222222] text-[#8a8480]">HPC Simulation</span>
            <span class="text-xs px-2 py-1 border border-[#222222] text-[#8a8480]">Quantum Physics</span>
            <span class="text-xs px-2 py-1 border border-[#222222] text-[#8a8480]">Peer-reviewed Publications</span>
            <span class="text-xs px-2 py-1 border border-[#222222] text-[#8a8480]">International Conferences</span>
          </div>
        </div>

        <!-- Energee3 -->
        <div class="relative pl-8 pb-12 border-l border-[#222222] group">
          <div class="absolute left-[-5px] top-1 w-2.5 h-2.5 rounded-full bg-[#333333] group-hover:bg-[#c9a84c] transition-colors"></div>
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2 mb-3">
            <div>
              <h3 class="text-lg font-medium text-[#f5f0eb]">Software Developer</h3>
              <p class="text-sm text-[#c9a84c]">Energee3 S.r.l.</p>
            </div>
            <span class="text-sm text-[#8a8480] whitespace-nowrap">Set 2018 – Feb 2021</span>
          </div>
          <p class="text-sm text-[#8a8480] leading-relaxed max-w-2xl mb-3">
            API REST e servizi web in Python per sistemi backend scalabili. Sviluppo e implementazione di algoritmi di ottimizzazione complessa per la logistica sanitaria.
          </p>
          <div class="p-3 border border-[#1a1a1a] bg-[#0d0d0d]">
            <p class="text-xs text-[#f5f0eb]">
              <span class="text-[#c9a84c]">→</span> Google OR-Tools: riduzione del <strong>15%</strong> della distanza totale percorsa per medico/giorno rispetto alla pianificazione di riferimento
            </p>
            <p class="text-xs text-[#f5f0eb] mt-1">
              <span class="text-[#c9a84c]">→</span> Coda priorità pazienti: copertura del <strong>99%</strong> entro 3 giorni (vs 87% senza escalation di priorità)
            </p>
          </div>
        </div>

        <!-- Multitraccia -->
        <div class="relative pl-8 pb-12 border-l border-[#222222] group">
          <div class="absolute left-[-5px] top-1 w-2.5 h-2.5 rounded-full bg-[#333333] group-hover:bg-[#c9a84c] transition-colors"></div>
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2 mb-3">
            <div>
              <h3 class="text-lg font-medium text-[#f5f0eb]">Data Scientist</h3>
              <p class="text-sm text-[#c9a84c]">Multitraccia S.C.</p>
            </div>
            <span class="text-sm text-[#8a8480] whitespace-nowrap">Mar 2021 – Apr 2022</span>
          </div>
          <p class="text-sm text-[#8a8480] leading-relaxed max-w-2xl">
            Sviluppo di applicazioni web per strategie di business intelligence Industry 4.0. Unico punto di riferimento tecnico per sistemi ML intelligenti. Progettazione, sviluppo e ownership tecnica completa.
          </p>
        </div>

        <!-- Extendi -->
        <div class="relative pl-8 pb-12 border-l border-[#222222] group">
          <div class="absolute left-[-5px] top-1 w-2.5 h-2.5 rounded-full bg-[#333333] group-hover:bg-[#c9a84c] transition-colors"></div>
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2 mb-3">
            <div>
              <h3 class="text-lg font-medium text-[#f5f0eb]">Senior Data Scientist — NLP & LLM Systems</h3>
              <p class="text-sm text-[#c9a84c]">Extendi S.r.l.</p>
            </div>
            <span class="text-sm text-[#8a8480] whitespace-nowrap">Apr 2022 – Presente</span>
          </div>
          <p class="text-sm text-[#8a8480] leading-relaxed max-w-2xl mb-3">
            Progettazione e implementazione di sistemi NLP e LLM su larga scala per piattaforme di audience intelligence. Fine-tuning, inferenza custom, generazione sintetica di dati, API di servizi ML in produzione su AWS e Azure.
          </p>
          <div class="p-3 border border-[#1a1a1a] bg-[#0d0d0d] space-y-1">
            <p class="text-xs text-[#f5f0eb]">
              <span class="text-[#c9a84c]">→</span> Dataset sintetico (Llama 3 + Mixtral 8x7B): espansione del <strong>300%</strong> mantenendo distribuzione etichette e rilevanza del dominio
            </p>
            <p class="text-xs text-[#f5f0eb]">
              <span class="text-[#c9a84c]">→</span> Sistemi LLM validati per estrazione e riassunto di informazioni su audience pubbliche non strutturate
            </p>
          </div>
        </div>

        <!-- Fargin Academy -->
        <div class="relative pl-8 pb-0 border-l border-transparent group">
          <div class="absolute left-[-5px] top-1 w-2.5 h-2.5 rounded-full bg-[#c9a84c]"></div>
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2 mb-3">
            <div>
              <h3 class="text-lg font-medium text-[#f5f0eb]">Docente di Corso AI — Sistemi Agentici & MCP</h3>
              <p class="text-sm text-[#c9a84c]">Fargin Academy</p>
            </div>
            <span class="text-sm text-[#8a8480] whitespace-nowrap">Set 2025 – Presente</span>
          </div>
          <p class="text-sm text-[#8a8480] leading-relaxed max-w-2xl">
            Insegno agli sviluppatori come costruire flussi di lavoro agentici deterministici e scalabili usando il Model Context Protocol (MCP). Il corso copre i fondamenti dell'AI, l'architettura dei sistemi agentici e le best practice per soluzioni in produzione.
          </p>
        </div>
      </div>

      <!-- Competenze chiave -->
      <div class="mt-20 pt-12 border-t border-[#111111]">
        <h3 class="text-xs tracking-[0.3em] uppercase text-[#8a8480] mb-8">Competenze Tecniche Chiave</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-5 border border-[#1a1a1a] hover:border-[#333333] transition-colors">
            <h4 class="text-sm font-medium text-[#c9a84c] mb-3">AI & LLM Systems</h4>
            <ul class="space-y-1 text-xs text-[#8a8480]">
              <li>Sistemi agentici deterministici (MCP)</li>
              <li>Fine-tuning LLM (Llama 3, Mixtral, GPT)</li>
              <li>Generazione sintetica di dati</li>
              <li>RAG e vector search</li>
              <li>NLP pipeline production-ready</li>
            </ul>
          </div>
          <div class="p-5 border border-[#1a1a1a] hover:border-[#333333] transition-colors">
            <h4 class="text-sm font-medium text-[#c9a84c] mb-3">Engineering & Cloud</h4>
            <ul class="space-y-1 text-xs text-[#8a8480]">
              <li>Python, Ruby, FastAPI, Rails</li>
              <li>AWS, Azure (ML services)</li>
              <li>MySQL, PostgreSQL</li>
              <li>Git, CircleCI, Agile/Scrum</li>
              <li>Algoritmi di ottimizzazione (OR-Tools)</li>
            </ul>
          </div>
          <div class="p-5 border border-[#1a1a1a] hover:border-[#333333] transition-colors">
            <h4 class="text-sm font-medium text-[#c9a84c] mb-3">Verticali di Dominio</h4>
            <ul class="space-y-1 text-xs text-[#8a8480]">
              <li>FSI — compliance e sicurezza AI</li>
              <li>Audience intelligence & media</li>
              <li>Industry 4.0 & business intelligence</li>
              <li>Logistica & ottimizzazione operativa</li>
              <li>Healthcare scheduling</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BLOG PREVIEW -->
  <section class="py-32 px-6 border-t border-[#111111]">
    <div class="max-w-5xl mx-auto">
      <div class="flex items-end justify-between mb-16">
        <div>
          <span class="text-xs tracking-[0.3em] uppercase text-[#c9a84c] font-medium">Articoli</span>
          <h2 class="text-3xl md:text-4xl font-light mt-3 text-[#f5f0eb]">
            Approfondimenti tecnici<br />per decisori enterprise
          </h2>
        </div>
        <a href="/blog" class="hidden md:inline-flex items-center gap-2 text-sm text-[#8a8480] hover:text-[#f5f0eb] transition-colors">
          Tutti gli articoli
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-[#111111]">
        <a href="/blog/agentic-workflow-2026" class="bg-[#0a0a0a] p-8 hover:bg-[#0d0d0d] transition-colors group">
          <span class="text-xs text-[#c9a84c] tracking-widest uppercase">Strategia AI</span>
          <h3 class="text-base font-medium text-[#f5f0eb] mt-3 mb-4 leading-snug group-hover:text-[#c9a84c] transition-colors">
            Perché la vostra azienda ha bisogno di un Agentic Workflow nel 2026
          </h3>
          <p class="text-xs text-[#8a8480] leading-relaxed">
            I sistemi agentici non sono un'evoluzione dei chatbot. Sono una nuova classe di architettura software. Cosa significa per le aziende enterprise.
          </p>
        </a>

        <a href="/blog/ai-fsi-compliance" class="bg-[#0a0a0a] p-8 hover:bg-[#0d0d0d] transition-colors group">
          <span class="text-xs text-[#c9a84c] tracking-widest uppercase">FSI & Compliance</span>
          <h3 class="text-base font-medium text-[#f5f0eb] mt-3 mb-4 leading-snug group-hover:text-[#c9a84c] transition-colors">
            AI nell'universo FSI: Sicurezza, Compliance e Scalabilità
          </h3>
          <p class="text-xs text-[#8a8480] leading-relaxed">
            Banche e assicurazioni adottano AI sotto la pressione di DORA e AI Act. Come costruire sistemi che passino i controlli normativi senza sacrificare l'efficacia.
          </p>
        </a>

        <a href="/blog/multi-agent-systems" class="bg-[#0a0a0a] p-8 hover:bg-[#0d0d0d] transition-colors group">
          <span class="text-xs text-[#c9a84c] tracking-widest uppercase">Architettura</span>
          <h3 class="text-base font-medium text-[#f5f0eb] mt-3 mb-4 leading-snug group-hover:text-[#c9a84c] transition-colors">
            Dall'automazione alla collaborazione: l'era dei Multi-Agent Systems
          </h3>
          <p class="text-xs text-[#8a8480] leading-relaxed">
            Un singolo agente AI è potente. Un sistema di agenti coordinati è trasformativo. Principi di progettazione per architetture multi-agente robuste.
          </p>
        </a>
      </div>

      <div class="mt-8 md:hidden">
        <a href="/blog" class="inline-flex items-center gap-2 text-sm text-[#8a8480] hover:text-[#f5f0eb] transition-colors">
          Tutti gli articoli →
        </a>
      </div>
    </div>
  </section>

  <!-- CTA / BOOKING -->
  <section id="booking" class="py-32 px-6 border-t border-[#111111]">
    <div class="max-w-5xl mx-auto">
      <div class="max-w-2xl">
        <span class="text-xs tracking-[0.3em] uppercase text-[#c9a84c] font-medium">Lavoriamo insieme</span>
        <h2 class="text-3xl md:text-4xl font-light mt-3 mb-6 text-[#f5f0eb]">
          AI Strategy Discovery Call
        </h2>
        <p class="text-[#8a8480] leading-relaxed mb-4">
          Una sessione di 30 minuti per capire dove l'AI può creare valore concreto nella vostra organizzazione.
          Nessun pitch. Nessuna proposta preconfezionata. Solo un'analisi tecnica onesta del vostro contesto.
        </p>
        <p class="text-sm text-[#8a8480] mb-10">
          <span class="text-[#f5f0eb]">Collaborazioni agili in regime B2B.</span> Consulente Senior Indipendente.
        </p>

        <a
          href="#booking"
          class="inline-flex items-center gap-3 px-8 py-4 bg-[#c9a84c] text-[#0a0a0a] text-sm font-medium tracking-widest uppercase hover:bg-[#a07c30] transition-colors duration-200"
        >
          Prenota una Discovery Call (30 min)
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

        <div class="mt-12 pt-12 border-t border-[#111111] grid grid-cols-1 sm:grid-cols-3 gap-8 text-sm">
          <div>
            <p class="text-[#c9a84c] font-medium mb-1">Localizzazione</p>
            <p class="text-[#8a8480]">Modena, Italia<br />Disponibile da remoto</p>
          </div>
          <div>
            <p class="text-[#c9a84c] font-medium mb-1">Verticali</p>
            <p class="text-[#8a8480]">FSI, Enterprise,<br />Industry 4.0, Media</p>
          </div>
          <div>
            <p class="text-[#c9a84c] font-medium mb-1">Contatti</p>
            <p class="text-[#8a8480]">
              <a href="mailto:luca.flammia@gmail.com" class="hover:text-[#f5f0eb] transition-colors">luca.flammia@gmail.com</a><br />
              <a href="https://linkedin.com/in/lucaflammia" target="_blank" rel="noopener" class="hover:text-[#f5f0eb] transition-colors">LinkedIn</a>
              &nbsp;·&nbsp;
              <a href="https://github.com/lucaflammia" target="_blank" rel="noopener" class="hover:text-[#f5f0eb] transition-colors">GitHub</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="py-8 px-6 border-t border-[#111111]">
    <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#444444]">
      <span>© 2026 Luca Flammia. P.IVA disponibile su richiesta.</span>
      <div class="flex items-center gap-6">
        <a href="/en" class="hover:text-[#8a8480] transition-colors tracking-widest uppercase">English</a>
        <a href="/blog" class="hover:text-[#8a8480] transition-colors">Articoli</a>
        <a href="#booking" class="hover:text-[#8a8480] transition-colors">Discovery Call</a>
      </div>
    </div>
  </footer>
</Layout>
